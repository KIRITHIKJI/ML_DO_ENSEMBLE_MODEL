# ── downloaded and derived data (re-creatable with src/data/download.py) ──
data/raw/
data/interim/
data/processed/

# ── trained model weights ────────────────────────────────────────────
models/**/*
models/*.pth
models/*.pkl
models/*.joblib
models/*.txt
models/*.json

# ── python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ── scratch ──────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak

# ── local tool / editor settings ─────────────────────────────────────
.claude/settings.local.json
# Playwright MCP profile and trace output from driving the app in a browser.
.playwright-mcp/
.DS_Store
Thumbs.db
desktop.ini

# ── large regenerable model output ───────────────────────────────────
# Per-row validation predictions (~120 MB). Re-created by
# src/models/baselines.py and src/models/train_ml.py. The metrics csv,
# feature importances and plots next to them ARE kept in git.
results/val/predictions/
# Archived per-row predictions (kept on disk for restore, not in git).
results/val/archive/predictions_*/
# Out-of-fold per-row predictions (~350 MB). Re-created by
# src/models/run_step7.py; the csv summaries beside them ARE kept.
results/val/oof/*.parquet
# Per-row 2025 test predictions (regenerable by src/evaluation/test_2025.py).
results/test/pred_*.parquet

# ── step 12: the deployed system ─────────────────────────────────────
# Live and 2026 data: downloaded, and re-created by
# `python -m src.deploy.fetch_live`. Never mixed with data/raw.
data/live/
# Per-row 2026 predictions (~90 MB), regenerable by
# src/deploy/score_2026.py. The metrics, intervals, per-station table,
# lead times, verdicts and walk-forward csvs beside them ARE kept.
results/live_2026/pred_*.parquet
# Runtime output of production runs: one csv per hour, the append-only log
# and the monitoring csvs. These belong to the machine that ran them, not
# to the repository.
results/live/
# Retrain candidates and archived model versions are weights.
models/candidate/
models/archive/

# The model card IS documentation and belongs in git, even though
# everything else under models/ is a weight file.
!models/final/
models/final/*
!models/final/MODEL_CARD.md

# Colab bundle made by make_colab_zip.py (too big for git)
ML_MAIN_V2_colab.zip
results/notebook_run/
do_demo_pack.npz
